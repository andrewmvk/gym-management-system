# Copy to .env and fill the blanks. Never commit .env.
# The same file feeds docker compose and the host processes started by pnpm dev.

NODE_ENV=development

# Local PostgreSQL inside the backend container, published on 127.0.0.1 only.
POSTGRES_USER=cadence
POSTGRES_PASSWORD=
POSTGRES_DB=cadence
# Host processes (pnpm dev, tests, Drizzle Studio). Inside the container compose builds its own URL.
DATABASE_URL=postgres://cadence:<POSTGRES_PASSWORD>@localhost:5432/cadence
# Separate database in the same container, created by the backend entrypoint. Tests truncate it freely.
TEST_DATABASE_URL=postgres://cadence:<POSTGRES_PASSWORD>@localhost:5432/cadence_test

# Passwords for the fixed demo staff accounts created by the seed (trainer@example.com, admin@example.com).
SEED_TRAINER_PASSWORD=
SEED_ADMIN_PASSWORD=

# API
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
JWT_SECRET=
KIOSK_API_KEY=
UPLOADS_DIR=./uploads

# AI (OpenRouter). AI_MODE=mock skips the network and returns fixtures; the key and model are required when live.
AI_MODE=live
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# Mock verdicts for the signup paths: cleared | not_cleared | unavailable.
AI_MOCK_APTITUDE=cleared
AI_MOCK_CERTIFICATE=cleared

# E-mail (Resend). EMAIL_MODE=log writes each e-mail, link included, to the API log; the key is required for resend.
EMAIL_MODE=log
RESEND_API_KEY=
EMAIL_FROM=Cadence <onboarding@resend.dev>

# Face embedding for signup photos: stub (deterministic hash of the bytes) | real (face-api.js weights, from P-22).
FACE_EMBEDDING_MODE=stub

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:4000
